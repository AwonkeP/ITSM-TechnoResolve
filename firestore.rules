rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isDesignatedAdmin() {
      return isSignedIn() && request.auth.token.email != null && (
        request.auth.token.email.lower() == 'tatiavumile@gmail.com' ||
        request.auth.token.email.lower() == 'avutati@gmail.com' ||
        request.auth.token.email.lower() == 'philibaneawonke@gmail.com' ||
        request.auth.token.email.lower() == 'maladze.mugeri@capaciti.org.za' ||
        request.auth.token.email.lower() == 'emihle.tom@capaciti.org.za' ||
        request.auth.token.email.lower() == 'malhilhibonani02@gmail.com'
      );
    }

    // RBAC: Roles are stored in /users/{userId}
    function getRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') 
        : 'user';
    }
    function isAdmin() {
      return isSignedIn() && (isDesignatedAdmin() || getRole() == 'admin');
    }
    function isTechnician() {
      return isSignedIn() && (isAdmin() || getRole() == 'technician');
    }
    
    // UserProfile schema validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'full_name', 'role', 'created_at'])
        && data.id is string && data.id.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.full_name is string && data.full_name.size() <= 128
        && data.role in ['admin', 'technician', 'user']
        && data.created_at is string && data.created_at.size() <= 64
        && (!data.keys().hasAny(['is_approved']) || data.is_approved is bool)
        && (!data.keys().hasAny(['email_verified']) || data.email_verified is bool)
        && (!data.keys().hasAny(['banned']) || data.banned is bool)
        && (!data.keys().hasAny(['avatar_url']) || (data.avatar_url is string && data.avatar_url.size() <= 2048))
        && (!data.keys().hasAny(['phone']) || (data.phone is string && data.phone.size() <= 32))
        && (!data.keys().hasAny(['verification_code']) || (data.verification_code is string && data.verification_code.size() <= 64))
        && (!data.keys().hasAny(['rejected']) || data.rejected is bool)
        && (!data.keys().hasAny(['company']) || (data.company is string && data.company.size() <= 128));
    }
    
    // Ticket schema validation
    function isValidTicket(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'category', 'priority', 'status', 'requester_id', 'requester_name', 'requester_email', 'created_at', 'updated_at'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 256
        && data.description is string && data.description.size() <= 10000
        && data.category is string && data.category.size() <= 64
        && data.priority is string && data.priority.size() <= 32
        && data.status is string && data.status.size() <= 32
        && data.requester_id is string && data.requester_id.size() <= 128
        && data.requester_name is string && data.requester_name.size() <= 128
        && data.requester_email is string && data.requester_email.size() <= 256
        && data.created_at is string && data.created_at.size() <= 64
        && data.updated_at is string && data.updated_at.size() <= 64
        && (!data.keys().hasAny(['company']) || (data.company is string && data.company.size() <= 128))
        && (!data.keys().hasAny(['assigned_to']) || (data.assigned_to is string && data.assigned_to.size() <= 128))
        && (!data.keys().hasAny(['assigned_name']) || (data.assigned_name is string && data.assigned_name.size() <= 128))
        && (!data.keys().hasAny(['ai_category']) || (data.ai_category is string && data.ai_category.size() <= 64))
        && (!data.keys().hasAny(['ai_confidence']) || data.ai_confidence is number)
        && (!data.keys().hasAny(['ai_reasoning']) || (data.ai_reasoning is string && data.ai_reasoning.size() <= 2048))
        && (!data.keys().hasAny(['ai_suggested_priority']) || (data.ai_suggested_priority is string && data.ai_suggested_priority.size() <= 32))
        && (!data.keys().hasAny(['resolved_at']) || (data.resolved_at is string && data.resolved_at.size() <= 64))
        && (!data.keys().hasAny(['attachments']) || data.attachments is list);
    }
    
    // TicketMessage schema validation
    function isValidTicketMessage(data) {
      return data.keys().hasAll(['id', 'ticket_id', 'ticket_requester_id', 'author_id', 'author_name', 'author_role', 'body', 'internal', 'created_at'])
        && data.id is string && data.id.size() <= 128
        && data.ticket_id is string && data.ticket_id.size() <= 128
        && data.ticket_requester_id is string && data.ticket_requester_id.size() <= 128
        && data.author_id is string && data.author_id.size() <= 128
        && data.author_name is string && data.author_name.size() <= 128
        && data.author_role is string && data.author_role.size() <= 32
        && data.body is string && data.body.size() <= 10000
        && data.internal is bool
        && data.created_at is string && data.created_at.size() <= 64
        && (!data.keys().hasAny(['attachments']) || data.attachments is list);
    }
    
    // AppNotification schema validation
    function isValidAppNotification(data) {
      return data.keys().hasAll(['id', 'title', 'message', 'type', 'read', 'created_at'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 256
        && data.message is string && data.message.size() <= 1024
        && data.type is string && data.type.size() <= 64
        && data.read is bool
        && data.created_at is string && data.created_at.size() <= 64
        && (!data.keys().hasAny(['user_id']) || (data.user_id is string && data.user_id.size() <= 128))
        && (!data.keys().hasAny(['link_page']) || (data.link_page is string && data.link_page.size() <= 256))
        && (!data.keys().hasAny(['target_id']) || (data.target_id is string && data.target_id.size() <= 128));
    }
    
    // EmailOutboxItem schema validation
    function isValidEmailOutboxItem(data) {
      return data.keys().hasAll(['id', 'to', 'subject', 'template', 'status', 'created_at'])
        && data.id is string && data.id.size() <= 128
        && data.to is string && data.to.size() <= 256
        && data.subject is string && data.subject.size() <= 256
        && data.template is string && data.template.size() <= 64
        && data.status in ['sent', 'queued', 'failed', 'delivered']
        && data.created_at is string && data.created_at.size() <= 64
        && (!data.keys().hasAny(['ticket_id']) || (data.ticket_id is string && data.ticket_id.size() <= 128))
        && (!data.keys().hasAny(['payload']) || (data.payload is string && data.payload.size() <= 10000));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      
      allow create: if isSignedIn() 
        && isValidId(userId) 
        && isValidUserProfile(incoming())
        && userId == request.auth.uid
        && (
          isDesignatedAdmin() || 
          (incoming().role == 'user' || incoming().role == 'admin') // Allow admin because First User needs it
        );
        
      allow update: if isSignedIn() 
        && isValidId(userId) 
        && isValidUserProfile(incoming())
        && incoming().id == existing().id
        && (
          isAdmin() || 
          (userId == request.auth.uid && incoming().role == existing().role && incoming().banned == existing().banned && incoming().is_approved == existing().is_approved)
        );
        
      allow delete: if isAdmin();
    }
    
    match /tickets/{ticketId} {
      allow get: if isSignedIn() 
        && isValidId(ticketId)
        && (isAdmin() || isTechnician() || existing().requester_id == request.auth.uid);
        
      allow list: if isSignedIn()
        && (isAdmin() || isTechnician() || resource.data.requester_id == request.auth.uid);
        
      allow create: if isSignedIn()
        && isValidId(ticketId)
        && isValidTicket(incoming())
        && incoming().id == ticketId
        && (isAdmin() || isTechnician() || incoming().requester_id == request.auth.uid);
        
      allow update: if isSignedIn()
        && isValidId(ticketId)
        && isValidTicket(incoming())
        && incoming().id == existing().id
        && incoming().requester_id == existing().requester_id
        && (
          isAdmin() ||
          isTechnician() ||
          (existing().requester_id == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updated_at', 'attachments', 'description']))
        );
        
      allow delete: if isAdmin();
    }
    
    match /messages/{messageId} {
      allow get: if isSignedIn()
        && isValidId(messageId)
        && (
          isAdmin() || isTechnician() || 
          (existing().ticket_requester_id == request.auth.uid && existing().internal == false)
        );
        
      allow list: if isSignedIn()
        && (
          isAdmin() || isTechnician() || 
          (resource.data.ticket_requester_id == request.auth.uid && resource.data.internal == false)
        );
        
      allow create: if isSignedIn()
        && isValidId(messageId)
        && isValidTicketMessage(incoming())
        && incoming().id == messageId
        && (isAdmin() || isTechnician() || (incoming().ticket_requester_id == request.auth.uid && incoming().author_id == request.auth.uid && incoming().internal == false));
        
      allow update: if false; // Messages are immutable
      allow delete: if isAdmin();
    }
    
    match /notifications/{notificationId} {
      allow get: if isSignedIn()
        && isValidId(notificationId)
        && (isAdmin() || existing().user_id == request.auth.uid || existing().user_id == 'all');
        
      allow list: if isSignedIn()
        && (isAdmin() || resource.data.user_id == request.auth.uid || resource.data.user_id == 'all');
        
      allow create: if isSignedIn()
        && isValidId(notificationId)
        && isValidAppNotification(incoming())
        && incoming().id == notificationId;
        
      allow update: if isSignedIn()
        && isValidId(notificationId)
        && isValidAppNotification(incoming())
        && incoming().id == existing().id
        && incoming().user_id == existing().user_id
        && (isAdmin() || ((existing().user_id == request.auth.uid || existing().user_id == 'all') && incoming().diff(existing()).affectedKeys().hasOnly(['read'])));
        
      allow delete: if isAdmin();
    }
    
    match /outbox/{outboxId} {
      allow get, list: if isAdmin();
      
      allow create: if isSignedIn()
        && isValidId(outboxId)
        && isValidEmailOutboxItem(incoming())
        && incoming().id == outboxId;
        
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
